#!/bin/sh
# Pre-commit hook: verify code formatting and run tests.
# Install: git config core.hooksPath .githooks

set -e

# Windows detection: if running on Windows without a POSIX shell, direct to PowerShell hook
if [ "${OS:-}" = "Windows_NT" ]; then
    echo "⚠️  Windows detected. If this script fails, run the PowerShell hook instead:"
    echo "   pwsh .githooks/pre-commit.ps1"
    echo "   See CONTRIBUTING.md for details."
fi

echo "🔍 Checking code formatting..."
dotnet format --verify-no-changes --no-restore
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Formatting issues found. Run 'dotnet format' to fix them."
  exit 1
fi

echo "✅ Formatting OK"
echo "🧪 Running tests..."
dotnet test tests/BSE_Code.Tests.csproj --no-restore -c Release --verbosity quiet
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Tests failed. Fix them before committing."
  exit 1
fi

echo "✅ All checks passed"
